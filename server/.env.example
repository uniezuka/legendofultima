PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Postgres connection string (Prisma). Swappable to any Postgres host —
# nothing else in the code references the provider.
DATABASE_URL=postgresql://user:password@localhost:5432/legendofultima?schema=public

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Blank in dev. Set to the apex domain in prod only if the frontend and
# backend share a registrable parent domain.
COOKIE_DOMAIN=

# Staged rollout flag for Socket.io handshake auth — see docs/AUTH_SPEC.md.
# Keep false until the authenticated frontend build is confirmed live.
REQUIRE_SOCKET_AUTH=false
